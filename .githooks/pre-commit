#!/usr/bin/env bash
# RubberSignal : contrôle avant chaque commit.
# Bloque le commit si un fichier préparé contient une clé API ou un fichier secret.
# N'affiche jamais la valeur d'une clé : seulement le fichier et le numéro de ligne.
# Activation (une fois par ordinateur) : git config core.hooksPath .githooks
# Contournement exceptionnel, déconseillé : git commit --no-verify

root=$(git rev-parse --show-toplevel) || exit 1
cd "$root" || exit 1

fail=0
alerte() { echo "  [BLOQUÉ] $1"; fail=1; }

# Valeurs réelles des clés lues dans .Renviron (jamais affichées)
noms=(); vals=()
if [ -f .Renviron ]; then
  while IFS= read -r ligne || [ -n "$ligne" ]; do
    ligne=${ligne%$'\r'}
    [[ "$ligne" =~ ^[[:space:]]*([A-Za-z_][A-Za-z0-9_]*)[[:space:]]*=(.*)$ ]] || continue
    v=${BASH_REMATCH[2]}; v=${v//\"/}; v=${v//\'/}; v=${v// /}
    [ ${#v} -ge 12 ] && { noms+=("${BASH_REMATCH[1]}"); vals+=("$v"); }
  done < .Renviron
fi

# Formats de clés connus + affectations du type NOM_KEY = "valeur longue"
motif='sk-ant-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{30,}|github_pat_[A-Za-z0-9_]{30,}|AKIA[0-9A-Z]{16}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(_key|_token|_secret|password)[[:space:]]*(=|<-)[[:space:]]*["'"'"']?[A-Za-z0-9_-]{16,}'

lignes() { cut -d: -f1 | head -5 | tr '\n' ' '; }

while IFS= read -r -d '' f; do
  case "$f" in .githooks/*) continue ;; esac

  # 1. Fichiers qui ne doivent jamais entrer dans le dépôt
  base=${f##*/}
  case "$base" in
    *.Renviron*|'$GITHUB_ENV'|.env|.env.*|*.pem|*.key|.credentials*|.Rhistory*)
      alerte "fichier secret : $f"; continue ;;
  esac
  case "$f" in secrets/*) alerte "fichier secret : $f"; continue ;; esac

  # 2. Valeur réelle d'une clé du .Renviron (fichiers texte uniquement)
  for i in "${!vals[@]}"; do
    l=$(git show ":$f" 2>/dev/null | grep -InF -- "${vals[$i]}" | lignes)
    [ -n "$l" ] && alerte "valeur de ${noms[$i]} dans $f (ligne $l)"
  done

  # 3. Format de clé reconnu
  l=$(git show ":$f" 2>/dev/null | grep -InEi -- "$motif" | lignes)
  [ -n "$l" ] && alerte "clé probable dans $f (ligne $l)"
done < <(git diff --cached --name-only --diff-filter=ACMR -z)

if [ $fail -ne 0 ]; then
  echo ""
  echo "Commit refusé : une clé API ou un fichier secret allait entrer dans le dépôt."
  echo "Retirez-le avec : git restore --staged <fichier>"
  echo "Les clés vont uniquement dans .Renviron (local) et dans les Secrets GitHub."
  exit 1
fi
exit 0
